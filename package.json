{
  "name": "@acmelabs/jev-gate",
  "version": "0.1.0",
  "private": true,
  "description": "A Claude Code PreToolUse gate: Jev scores each side-effecting tool call before it runs. Shadow mode logs only.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint scripts oxlint.config.ts oxfmt.config.ts",
    "format": "oxfmt scripts oxlint.config.ts oxfmt.config.ts",
    "format:check": "oxfmt --check scripts oxlint.config.ts oxfmt.config.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test && bun run version:sync -- --check",
    "test": "bun test",
    "report": "bun run scripts/report/report.ts",
    "version:sync": "bun run scripts/version/version-sync.ts",
    "validate": "bun run scripts/validate.ts",
    "changeset": "changeset",
    "version": "changeset version && bun run version:sync"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@types/bun": "^1.3.14",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "^5.6.0",
    "ultracite": "7.12.0"
  }
}
