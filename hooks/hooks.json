{
  "description": "jev-gate: score side-effecting tool calls before they run (shadow mode by default), and say at session start when no API key is set.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|Write|Edit|MultiEdit|NotebookEdit|WebFetch)$",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/scripts/gate/hook.ts\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/scripts/gate/session-start.ts\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
